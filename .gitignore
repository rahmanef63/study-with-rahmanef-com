# convex/_generated is COMMITTED in self-hosted setups (Dokploy etc) so the
# Docker build can typecheck without running codegen inside the container.
# If you deploy via Convex Cloud, you can re-add the ignore line.
.vercel
.DS_Store

# Added by si-coder deploy (secret-leak guard)
.env.*
!.env.example

# Only npm ships here — Dockerfile runs `npm ci` against package-lock.json.
# A second lockfile means `pnpm install` silently builds a different tree than
# production, which is how three dependencies stayed "removed" locally while
# the deployed image still had them.
pnpm-lock.yaml
