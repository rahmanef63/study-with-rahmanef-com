{
  "name": "belajar-with-rahmanef",
  "version": "0.0.0",
  "packageManager": "npm@10.9.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "convex:dev": "convex dev",
    "convex:codegen": "convex dev --once",
    "build:auto": "if [ -n \"$CONVEX_DEPLOY_KEY\" ]; then node scripts/setup-auth.mjs && convex deploy --cmd 'next build'; else next build; fi",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:staging": "playwright test",
    "e2e:prod": "playwright test",
    "pwa:icons": "node scripts/generateIcons.mjs",
    "pwa:screenshots": "node scripts/generateScreenshots.mjs",
    "setup:check": "node scripts/setup-check.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@convex-dev/auth": "^0.0.92",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.18.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.460.0",
    "mermaid": "^11.16.1",
    "next": "^16.0.0",
    "radix-ui": "^1.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "convex-test": "^0.0.54",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
